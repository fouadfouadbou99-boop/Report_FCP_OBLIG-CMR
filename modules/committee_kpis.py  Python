import numpy as np


def compute_committee_kpis(
        nav,
        benchmark,
        sensitivity):

    nav = nav.dropna()

    benchmark = benchmark.dropna()

    returns = nav.pct_change().dropna()

    bench_returns = benchmark.pct_change().dropna()

    n = min(
        len(returns),
        len(bench_returns)
    )

    returns = returns.tail(n)

    bench_returns = bench_returns.tail(n)

    active = returns - bench_returns

    tracking_error = (
        active.std()
        * np.sqrt(52)
    )

    information_ratio = 0

    if tracking_error > 0:

        information_ratio = (
            active.mean()
            * 52
        ) / tracking_error

    volatility = (
        returns.std()
        * np.sqrt(52)
    )

    sharpe = 0

    if volatility > 0:

        sharpe = (
            returns.mean()
            * 52
        ) / volatility

    var95 = np.percentile(
        returns,
        5
    )

    cvar95 = returns[
        returns <= var95
    ].mean()

    drawdown = (
        nav /
        nav.cummax()
        - 1
    )

    max_drawdown = drawdown.min()

    dv01 = float(sensitivity) * 0.0001

    convexity = (
        float(sensitivity) ** 2
    ) / 100

    return {

        "tracking_error": tracking_error,

        "information_ratio": information_ratio,

        "sharpe": sharpe,

        "var95": var95,

        "cvar95": cvar95,

        "max_drawdown": max_drawdown,

        "dv01": dv01,

        "convexity": convexity

    }

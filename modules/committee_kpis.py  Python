import numpy as np

def compute_committee_kpis(nav, benchmark, sensitivity):

    returns = nav.pct_change().dropna()

    bench_returns = benchmark.pct_change().dropna()

    active = returns - bench_returns

    tracking_error = active.std() * np.sqrt(52)

    information_ratio = 0

    if tracking_error != 0:
        information_ratio = (
            active.mean() * 52
        ) / tracking_error

    var95 = np.percentile(
        returns,
        5
    )

    cvar95 = returns[
        returns <= var95
    ].mean()

    drawdown = (
        nav / nav.cummax() - 1
    ).min()

    vol = (
        returns.std()
        * np.sqrt(52)
    )

    sharpe = 0

    if vol != 0:
        sharpe = (
            returns.mean() * 52
        ) / vol

    dv01 = (
        sensitivity
        * 0.0001
    )

    convexity = (
        sensitivity ** 2
    ) / 100

    return {

        "tracking_error": tracking_error,

        "information_ratio": information_ratio,

        "var95": var95,

        "cvar95": cvar95,

        "max_drawdown": drawdown,

        "sharpe": sharpe,

        "dv01": dv01,

        "convexity": convexity

    }

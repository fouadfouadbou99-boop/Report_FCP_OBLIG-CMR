import numpy as np


def compute_committee_kpis(
        returns,
        benchmark,
        sensitivity):

    returns = returns.dropna()

    benchmark = benchmark.dropna()

    n = min(
        len(returns),
        len(benchmark)
    )

    returns = returns.tail(n)

    benchmark = benchmark.tail(n)

    active = returns - benchmark

    tracking_error = (
        active.std()
        * np.sqrt(52)
    )

    information_ratio = 0

    if tracking_error > 0:

        information_ratio = (
            active.mean()
            * 52
        ) / tracking_error

    volatility = (
        returns.std()
        * np.sqrt(52)
    )

    sharpe = 0

    if volatility > 0:

        sharpe = (
            returns.mean()
            * 52
        ) / volatility

    var95 = np.percentile(
        returns,
        5
    )

    cvar95 = returns[
        returns <= var95
    ].mean()

    dv01 = (
        float(sensitivity)
        * 0.0001
    )

    convexity = (
        float(sensitivity)
        ** 2
    ) / 100

    return {

        "tracking_error":
        tracking_error,

        "information_ratio":
        information_ratio,

        "sharpe":
        sharpe,

        "var95":
        var95,

        "cvar95":
        cvar95,

        "dv01":
        dv01,

        "convexity":
        convexity

    }
